{
	"name": "sowapps/so-ingenious",
	"type": "symfony-bundle",
	"license": "MIT",
	"minimum-stability": "stable",
	"prefer-stable": true,
	"require": {
		"php": ">=8.1",
		"ext-ctype": "*",
		"ext-iconv": "*",
		"symfony/console": "^v7.3",
		"symfony/framework-bundle": "^v7.3",
		"symfony/yaml": "^v7.3",
		"sowapps/so-core": "*"
	},
	"require-dev": {
		"symfony/phpunit-bridge": "^7.3",
		"phpunit/phpunit": "^12.4"
	},
	"autoload": {
		"psr-4": {
			"Sowapps\\SoIngenious\\": "src/"
		}
	},
	"autoload-dev": {
		"psr-4": {
			"Sowapps\\SoIngenious\\Tests\\": "tests/"
		}
	},
	"authors": [
		{
			"name": "Florent HAZARD",
			"email": "contact@sowapps.com",
			"homepage": "https://sowapps.com",
			"role": "Developer"
		}
	],
	"config": {
		"allow-plugins": {
			"symfony/flex": false
		}
	}
}
